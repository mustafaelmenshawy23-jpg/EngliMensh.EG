      "dialogue": {
        "sourcePage": 75,
        "lines": [
          {
            "speaker": "Aly",
            "text": "Hi, Omar!"
          },
          {
            "speaker": "Omar",
            "text": "Hi, Aly. Let's talk about our senses."
          },
          {
            "speaker": "Aly",
            "text": "Great idea. Tell me—what can you see?"
          },
          {
            "speaker": "Omar",
            "text": "I can see the teacher and the desk."
          },
          {
            "speaker": "Aly",
            "text": "Look! A flower!"
          },
          {
            "speaker": "Omar",
            "text": "Wow! I can see it with my eyes."
          },
          {
            "speaker": "Aly",
            "text": "I can smell it with my nose. It smells nice!"
          },
          {
            "speaker": "Omar",
            "text": "I can hear the teacher with my ears."
          },
          {
            "speaker": "Aly",
            "text": "I can touch the desk with my hands."
          },
          {
            "speaker": "Omar",
            "text": "I have an apple. I can taste it with my tongue!"
          },
          {
            "speaker": "Aly",
            "text": "Yummy! We use our five senses every day!"
          },
          {
            "speaker": "Both",
            "text": "Yes! See, hear, smell, taste, and touch!"
          }
        ]
      },
      "languagePatterns": [
        "I can see with my eyes.",
        "I can hear with my ears.",
        "I can smell with my nose.",
        "I can taste with my tongue.",
        "I can touch with my hands."
